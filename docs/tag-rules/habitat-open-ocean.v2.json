      "id": "a_tubenoses",
      "rank": "family",
      "action": "assign",
      "values": [
        "Diomedeidae",
        "Procellariidae",
        "Hydrobatidae",
        "Oceanitidae"
      ],
      "note": "Albatrosses, petrels, shearwaters, prions, fulmars, diving-petrels and storm-petrels feed at sea far from land outside the breeding season."
    },
    {
      "id": "a_seabird_families",
      "rank": "family",
      "action": "assign",
      "values": [
        "Spheniscidae",
        "Alcidae",
        "Phaethontidae",
        "Fregatidae",
        "Sulidae",
        "Stercorariidae"
      ],
      "note": "Penguins, auks, tropicbirds, frigatebirds, boobies and gannets, skuas and jaegers: feed at sea, most well offshore."
    },
    {
      "id": "a_sea_ducks",
      "rank": "genus",
      "action": "assign",
      "values": [
        "Clangula"
      ],
      "note": "Long-tailed Duck winters well offshore on open sea. Scoters and eiders are mostly coastal, so they count only when their own article says open sea (CODEX1 cross-check, 2026-09-30)."
    },
    {
      "id": "a_pelagic_larids",
      "rank": "genus",
      "action": "assign",
      "values": [
        "Rissa",
        "Xema",
        "Creagrus",
        "Onychoprion",
        "Anous",
        "Gygis"
      ],
      "note": "Kittiwakes, Sabine's and Swallow-tailed Gulls, sooty-type terns, noddies and white-terns feed far out at sea."
    }
